{
  "name": "very_good_workflows_tests",
  "version": "0.0.0",
  "private": true,
  "description": "Validation tests for the reusable GitHub workflow templates provided by Very Good Workflows.",
  "scripts": {
    "test": "jest",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint test",
    "format": "prettier --write test eslint.config.js package.json",
    "format:check": "prettier --check test eslint.config.js package.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "js-yaml": "^4.1.0",
    "prettier": "^3.9.6"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
